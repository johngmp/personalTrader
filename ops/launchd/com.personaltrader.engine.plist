<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: ops/install-engine.sh fills in __ROOT__ and __UV__ and installs it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personaltrader.engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__ROOT__</string>
    <string>trader</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <!-- Every 15 minutes. Runs missed while the Mac sleeps happen once on wake. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/logs/engine.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/logs/engine.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
