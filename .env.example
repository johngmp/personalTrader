# Copy this file to .env and fill in your own values. Never commit .env or paste keys into chat.

# Alpaca PAPER keys: in the Alpaca dashboard, switch to your Paper account first,
# then generate keys. Paper keys start with "PK". Live keys ("AK...") are refused.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Telegram alerts (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# QuiverQuant (Phase 4, optional)
QUIVER_API_KEY=
